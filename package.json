{
  "name": "ps5-emu-shell",
  "productName": "PS5 Emu Shell",
  "version": "0.9.5",
  "description": "Launcher de emuladores estilo PS5, controlado por controle (Xbox/XInput, DualShock 4 e DualSense)",
  "type": "module",
  "main": "src/main/index.js",
  "author": "Felipe Aguiar",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "build": {
    "appId": "local.ps5emushell.launcher",
    "productName": "PS5 Emu Shell",
    "executableName": "PS5EmuShell",
    "directories": {
      "output": "app"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/7zip-bin/mac/**",
      "!node_modules/7zip-bin/linux/**",
      "!node_modules/7zip-bin/win/arm64/**",
      "!node_modules/7zip-bin/win/ia32/**",
      "!node_modules/node-hid/prebuilds/HID-darwin*/**",
      "!node_modules/node-hid/prebuilds/HID*-linux*/**",
      "!node_modules/node-hid/src/**",
      "!node_modules/node-hid/hidapi/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/7zip-bin/**",
      "node_modules/node-hid/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "icon": "src/icon.ico"
    },
    "afterPack": "build/after-pack.cjs"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "koffi": "^3.3.3",
    "node-hid": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rcedit": "^5.0.2"
  },
  "allowScripts": {
    "koffi@3.3.3": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.0.0": true
  }
}
